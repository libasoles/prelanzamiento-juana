---
import SocialLinks from './SocialLinks.astro';
---

<section class="intro">
  <p class="intro__kicker">Soy compositora, intérprete y actriz</p>
  <h1 class="intro__title"><span>transformo mis preguntas</span> <span>en canciones</span></h1>
  <SocialLinks variant="hero" mailHref="#contacto" />
</section>

<style is:global>
  .intro {
    padding: 0 var(--gutter) 56px; display: flex; flex-direction: column;
    align-items: center; text-align: center; gap: 22px;
  }
  .intro__kicker {
    margin-top: 56px; font-family: var(--mano); font-size: 18px; white-space: nowrap;
    text-transform: uppercase; letter-spacing: .5px;
  }
  .intro__title {
    font-family: var(--mano); font-weight: 400; font-size: 22px; line-height: 1.3;
    text-transform: uppercase; letter-spacing: 1px;
  }
  .intro__title span { display: block; }

  @media (min-width: 768px) {
    .intro { padding-bottom: 40px; }
    .intro__kicker { margin-top: 48px; font-size: 23px; letter-spacing: 1px; }
    .intro__title { font-size: 34px; line-height: 1.25; }
    .intro__title span { display: inline; }
  }
</style>
