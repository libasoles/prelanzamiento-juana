---
import { Image, Picture } from 'astro:assets';
import maquina from '../../assets/home/maquina-palabras.webp';
import estrella from '../../assets/home/estrella-blanca-a.webp';
---

<section class="palabras textura" id="palabras">
  <div class="palabras__in">
    <div class="palabras__copy">
      <p class="palabras__pastilla borde-mano">Palabras — preguntas — canciones</p>
      <h2 class="palabras__titulo">¡Mirá cómo viene mi primer disco!</h2>
      <div class="palabras__texto" aria-hidden="true"></div>
      <a class="palabras__cta" href="/palabras">Ver el proceso</a>
      <p class="palabras__nota">
        <Image src={estrella} alt="" widths={[20, 40, 60]} sizes="20px" format="webp" loading="lazy" />
        Se entra con el código de la postal.
      </p>
    </div>
    <div class="palabras__foto">
      <Picture
        src={maquina}
        alt="Máquina de escribir con una hoja que dice Palabras"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[350, 700, 1000]}
        sizes="(min-width: 768px) 400px, 350px"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style is:global>
  .palabras { position: relative; }
  .palabras__in { background: rgba(33,84,170,.82); padding: 56px var(--gutter); display: flex; flex-direction: column; gap: 20px; }
  .palabras__copy { display: contents; }
  .palabras__pastilla {
    order: 1; align-self: stretch; text-align: center; margin-bottom: 12px; padding: 6px 12px;
    font-family: var(--mano); font-size: 14px; white-space: nowrap; text-transform: uppercase; letter-spacing: .5px;
    border: 2px solid #fff;
  }
  .palabras__titulo { order: 2; font-family: var(--mano); font-weight: 400; font-size: 42px; line-height: 1.05; text-transform: uppercase; }
  .palabras__foto { order: 3; position: relative; margin: 10px 0; }
  .palabras__foto img { width: 100%; aspect-ratio: 1; object-fit: cover; transform: rotate(2deg); border: 10px solid #fff; box-sizing: border-box; display: block; }
  .palabras__foto::before {
    content: ''; position: absolute; z-index: 1; left: 30px; top: -26px; width: 56px; aspect-ratio: 600 / 834;
    background: url('../../assets/home/clip-papel-a.webp') center / contain no-repeat; transform: rotate(-10deg);
  }
  .palabras__texto { display: none; order: 4; }
  .palabras__cta {
    order: 5; display: flex; align-items: center; justify-content: center; min-height: 56px;
    background: #fff; color: #2154aa; text-decoration: none; font-weight: 600; font-size: 18px;
  }
  .palabras__cta:hover, .palabras__cta:focus-visible { background: #e9edf9; color: #2154aa; text-decoration: underline; text-underline-offset: 4px; }
  .palabras__nota { order: 6; font-size: 14px; color: #e9edf9; display: flex; align-items: center; gap: 8px; }
  .palabras__nota img { width: 20px; height: 20px; object-fit: contain; flex: none; }

  @media (min-width: 768px) {
    .palabras__in {
      padding: 84px var(--gutter); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 24px; align-items: center;
    }
    .palabras__copy { grid-column: 1 / span 6; display: flex; flex-direction: column; gap: 20px; }
    .palabras__pastilla { align-self: flex-start; margin-bottom: 0; padding: 5px 16px; font-size: 19px; letter-spacing: 1px; }
    .palabras__titulo { font-size: 50px; font-feature-settings: 'calt' 0; font-variant-ligatures: none; }
    /* Espacio vacío: conserva la altura de las dos líneas de texto que había. */
    .palabras__texto { display: block; height: 3.2em; font-size: 17px; }
    .palabras__cta { align-self: flex-start; display: inline-flex; padding: 0 28px; min-height: 52px; font-size: 16px; }
    .palabras__foto { grid-column: 8 / span 4; margin: 0; }
    .palabras__foto::before { left: 40px; top: -28px; width: 62px; }
  }
</style>
