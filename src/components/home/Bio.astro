---
import { Image, Picture } from 'astro:assets';
import retrato from '../../assets/home/retrato-bn.jpg';
import clip from '../../assets/home/clip-papel-b.webp';
import Recorrido from './Recorrido.astro';
---

<section class="bio" id="bio">
  <div class="bio__col">
    <div class="bio__foto">
      <div class="bio__polaroid">
        <Picture
          src={retrato}
          alt="Retrato en blanco y negro de Juana, con la mano en la cabeza"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[300, 450, 600, 900]}
          sizes="(min-width: 768px) 480px, 300px"
          loading="lazy"
        />
        <p class="bio__nombre">Juana Cabrera</p>
      </div>
      <Image class="bio__clip" src={clip} alt="" widths={[77, 154, 240]} sizes="77px" format="webp" loading="lazy" />
    </div>
    <div class="papel bio__texto">
      <p class="maq">Empecé en 2014, bailando y actuando. En 2020 me sumé a Otro Mundo, y ese camino me llevó a actuar como Tomika en School of Rock, en el Teatro Gran Rex.</p>
      <p class="maq">Compongo mis propias canciones y creo que soy una intérprete muy versátil. Mi lenguaje está evolucionando todo el tiempo.</p>
    </div>
  </div>
  <Recorrido />
</section>

<style is:global>
  .bio { position: relative; isolation: isolate; padding: 40px var(--gutter) 0; display: flex; flex-direction: column; gap: 8px; }
  .bio__col { display: flex; flex-direction: column; gap: 8px; }
  .bio__foto { position: relative; width: 84%; margin-left: 4%; }
  .bio__polaroid { background: #fff; padding: 12px 12px 48px; transform: rotate(-3deg); box-shadow: 0 16px 30px rgba(0,0,0,.6); }
  .bio__polaroid img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; }
  .bio__nombre { margin-top: 10px; font-family: var(--mano); font-size: 22px; color: #2154aa; line-height: 1; text-transform: uppercase; }
  .bio__clip { position: absolute; right: 18px; top: -29px; width: 66px; transform: rotate(10deg); }
  .bio__texto {
    margin-top: -20px; padding: 128px 30px 44px; transform: rotate(1.5deg);
    display: flex; flex-direction: column; gap: 14px;
  }

  @media (min-width: 768px) {
    .bio {
      padding: 100px var(--gutter) 60px; display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: start;
    }
    .bio__col { grid-column: 1 / span 6; }
    .bio__foto { width: 82%; margin-left: 6%; padding-top: 24px; }
    .bio__polaroid { padding: 14px 14px 56px; box-shadow: 0 16px 32px rgba(0,0,0,.6); }
    .bio__nombre { margin-top: 12px; font-size: 24px; }
    .bio__clip { right: 30px; top: -10px; width: 77px; }
    .bio__texto { padding: 136px 56px 62px; gap: 16px; }
    .bio__texto p { font-size: 22px; }
    /* Flor decorativa (solo escritorio, como fondo CSS: no se descarga en mobile). */
    .bio::after {
      content: ''; position: absolute; z-index: -1; left: 65.83%; bottom: -135px; width: 26.4%;
      aspect-ratio: 1; background: url('../../assets/home/flor-1.webp') center / contain no-repeat;
      transform: rotate(-8deg); pointer-events: none;
    }
  }
</style>
