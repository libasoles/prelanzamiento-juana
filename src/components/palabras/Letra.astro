---
import { Image } from 'astro:assets';
import afiche from '../../assets/palabras/img-052-afiche.webp';
---

<section id="letra" class="pl-textura letra">
  <div class="letra-in">
    <div class="letra-wrap">
      <div class="hoja-aneja-sombra letra-a">
        <div class="hoja-aneja mano">
          <p class="letra-titulo">Descubrir el mundo <br class="letra-br" />es hacer preguntas.</p>
          <p class="letra-lado">Las mismas preguntas son las que nos unen, nos hacen parte de algo. Nos llevan por un mismo camino.</p>
          <p class="letra-lado">Un camino que descubre que la vida es un gran conjunto de misterios.</p>
        </div>
      </div>
      <div class="hoja-aneja-sombra letra-b">
        <div class="hoja-aneja hoja-aneja-b mano">
          <p class="letra-cuerpo">El rol del artista es develar los misterios encontrando la forma de la pregunta como una canción, un cuadro, una foto, un poema,... como una película de la vida.</p>
        </div>
      </div>
      <Image
        class="letra-afiche"
        src={afiche}
        alt="Juana cantando con la cabeza hacia atrás, de camisa blanca y jeans, frente a un telón, en una foto antigua de papel doblado"
        width={680}
        height={966}
        loading="lazy"
      />
    </div>
  </div>
</section>

<style is:global>
  .letra-in { background: rgba(33, 84, 170, 0.86); padding: 64px 16px 72px; }
  .hoja-aneja-sombra { filter: drop-shadow(0 18px 24px rgba(0, 10, 40, 0.4)); }
  .hoja-aneja {
    position: relative;
    box-sizing: border-box;
    color: #12306a;
    background-color: #e4dccb;
    background-image: radial-gradient(ellipse at 50% 45%, rgba(255, 246, 214, 0) 38%, rgba(150, 104, 40, 0.34) 100%), linear-gradient(rgba(206, 168, 98, 0.3), rgba(206, 168, 98, 0.3)), url('../../assets/palabras/carton-liso.jpg');
    background-size: 100% 100%, 100% 100%, cover;
    clip-path: polygon(0.0% 6.4px,2.5% 2.2px,5.0% 5.3px,7.5% 4.2px,10.0% 6.2px,12.5% 3.8px,15.0% 6.1px,17.5% 2.7px,20.0% 6.5px,22.5% 3.9px,25.0% 2.8px,27.5% 3.6px,30.0% 4.8px,32.5% 2.2px,35.0% 3.7px,37.5% 2.0px,40.0% 2.3px,42.5% 2.8px,45.0% 3.0px,47.5% 3.2px,50.0% 5.5px,52.5% 3.9px,55.0% 5.9px,57.5% 6.0px,60.0% 6.0px,62.5% 6.3px,65.0% 4.6px,67.5% 5.0px,70.0% 6.0px,72.5% 4.4px,75.0% 2.6px,77.5% 4.3px,80.0% 4.4px,82.5% 2.8px,85.0% 2.4px,87.5% 2.8px,90.0% 5.1px,92.5% 5.7px,95.0% 5.0px,97.5% 3.9px,100.0% 2.1px,calc(100% - 2.0px) 7.1%,calc(100% - 4.9px) 14.3%,calc(100% - 4.4px) 21.4%,calc(100% - 4.1px) 28.6%,calc(100% - 2.8px) 35.7%,calc(100% - 2.6px) 42.9%,calc(100% - 2.8px) 50.0%,calc(100% - 2.6px) 57.1%,calc(100% - 4.7px) 64.3%,calc(100% - 3.4px) 71.4%,calc(100% - 4.5px) 78.6%,calc(100% - 3.9px) 85.7%,calc(100% - 4.5px) 92.9%,calc(100% - 5.3px) 100.0%,97.5% calc(100% - 5.5px),95.0% calc(100% - 2.7px),92.5% calc(100% - 6.3px),90.0% calc(100% - 5.8px),87.5% calc(100% - 5.7px),85.0% calc(100% - 4.0px),82.5% calc(100% - 6.3px),80.0% calc(100% - 5.7px),77.5% calc(100% - 3.1px),75.0% calc(100% - 5.1px),72.5% calc(100% - 5.8px),70.0% calc(100% - 5.4px),67.5% calc(100% - 6.0px),65.0% calc(100% - 4.4px),62.5% calc(100% - 5.0px),60.0% calc(100% - 2.3px),57.5% calc(100% - 5.0px),55.0% calc(100% - 2.7px),52.5% calc(100% - 5.3px),50.0% calc(100% - 6.1px),47.5% calc(100% - 3.7px),45.0% calc(100% - 2.3px),42.5% calc(100% - 2.2px),40.0% calc(100% - 4.3px),37.5% calc(100% - 2.7px),35.0% calc(100% - 5.3px),32.5% calc(100% - 4.7px),30.0% calc(100% - 4.3px),27.5% calc(100% - 5.0px),25.0% calc(100% - 2.7px),22.5% calc(100% - 4.1px),20.0% calc(100% - 2.2px),17.5% calc(100% - 4.5px),15.0% calc(100% - 5.6px),12.5% calc(100% - 2.7px),10.0% calc(100% - 5.1px),7.5% calc(100% - 6.5px),5.0% calc(100% - 3.5px),2.5% calc(100% - 2.9px),0.0% calc(100% - 3.1px),5.7px 92.9%,2.4px 85.7%,5.5px 78.6%,3.2px 71.4%,5.4px 64.3%,6.0px 57.1%,5.8px 50.0%,2.9px 42.9%,4.5px 35.7%,3.4px 28.6%,5.9px 21.4%,3.3px 14.3%,2.8px 7.1%);
    font-weight: 400;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }
  .letra-wrap { display: flex; flex-direction: column; }
  .letra-a .hoja-aneja { padding: 56px 26px 64px; display: flex; flex-direction: column; gap: 26px; }
  .hoja-aneja p { margin: 0; font-size: 26px; }
  .hoja-aneja .letra-titulo { font-size: 36px; line-height: 1.15; }
  .letra-br { display: none; }
  .letra-b { position: relative; width: 94%; margin: -52px 0 0 auto; transform: rotate(-1deg); }
  .letra-b .hoja-aneja { padding: 46px 22px 64px; }
  .letra-afiche {
    display: block;
    width: 70%;
    max-width: 280px;
    height: auto;
    margin: -48px auto 0;
    position: relative;
    transform: rotate(2deg);
    filter: drop-shadow(0 18px 26px rgba(0, 10, 40, 0.45));
  }

  @media (min-width: 768px) {
    .letra-in { background: rgba(33, 84, 170, 0.86); padding: 130px clamp(24px, 5.5vw, 80px) 150px; }
    /* Dos hojas y el afiche: el afiche ocupa la misma celda que la primera hoja y el texto lo esquiva. */
    .letra-wrap { max-width: 1120px; margin: 0 auto; position: relative; display: grid; grid-template-columns: 100%; container-type: inline-size; --fs1: clamp(44px, 4.4vw, 64px); --afiche-w: min(340px, calc((100cqw - 240px) * 0.386)); }
    .letra-a { grid-area: 1 / 1; display: flex; }
    .letra-a .hoja-aneja { flex: 1; display: block; padding: 100px 120px 90px; letter-spacing: 1px; }
    .hoja-aneja p { font-size: clamp(30px, 2.9vw, 42px); }
    .hoja-aneja .letra-titulo { margin: 0 0 38px; font-size: var(--fs1); }
    .letra-br { display: inline; }
    .letra-a .letra-lado { margin: 0 0 38px; margin-right: calc(var(--afiche-w) - 64px); }
    .letra-a .letra-lado:last-child { margin-bottom: 0; }
    .letra-b { grid-area: 2 / 1; width: 88%; margin: -28px 0 0 auto; transform: rotate(-1.2deg); }
    .letra-b .hoja-aneja { padding: 76px 30% 84px 110px; letter-spacing: 1px; }
    .hoja-aneja-b::after {
      content: '';
      position: absolute;
      right: 5%;
      top: 50%;
      width: 17%;
      aspect-ratio: 600 / 888;
      background: url('../../assets/palabras/caras-3.webp') 0 0 / 100% 100% no-repeat;
      transform: translateY(-50%) rotate(4deg);
      mix-blend-mode: multiply;
      pointer-events: none;
    }
    .letra-afiche {
      grid-area: 1 / 1;
      align-self: start;
      justify-self: end;
      z-index: 2;
      width: var(--afiche-w);
      max-width: none;
      margin: calc(100px + var(--fs1) * 2.3 + 38px + 6px) 20px 114px 0;
      transform: rotate(3deg);
    }
  }
</style>
