---
import '../styles/fonts.css';
import icon from '../assets/brand/icon-dark-ink.png';
import iconLight from '../assets/brand/icon-light-ink.png';
import appleIcon from '../assets/brand/apple-touch-icon.png';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica, p. ej. "/" o "/palabras". */
  path: string;
  /** Imagen Open Graph, ruta pública (1200×630). */
  ogImage: string;
  ogImageAlt: string;
  ogType?: string;
  noindex?: boolean;
  /** Objetos JSON-LD (se serializan en <script type="application/ld+json">). */
  jsonLd?: Record<string, unknown>[];
  /** Color de fondo inicial, evita destello blanco. */
  background?: string;
}

const {
  title,
  description,
  path,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  background = '#000',
} = Astro.props;

const site = Astro.site ?? new URL('https://juanacabrera.com.ar');
const canonical = new URL(path, site).href;
const image = new URL(ogImage, site).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Juana Cabrera" />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={icon.src} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href={iconLight.src} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href={appleIcon.src} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Juana Cabrera" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
    <style is:global define:vars={{ 'page-bg': background }}>
      html { background: var(--page-bg); }
      body { margin: 0; background: var(--page-bg); }
      img { max-width: 100%; }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
